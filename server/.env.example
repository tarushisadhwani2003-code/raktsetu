# Copy this file to "server/.env" and adjust the values.
# On Vercel, set these variables in Project Settings > Environment Variables instead.

# --- Server ---
NODE_ENV=development
PORT=5000

# --- Database ---
# Local MongoDB (MongoDB Community Server running on your PC):
MONGODB_URI=mongodb://127.0.0.1:27017/raktsetu
# Vercel cannot connect to the database on your PC via localhost.
# Deployment needs a secured remote Community Server or MongoDB Atlas:
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/raktsetu?retryWrites=true&w=majority

# --- Login security ---
# Required in production: a long random string (at least 32 characters).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Website address ---
# Used in password-reset emails. In development the Vite dev server runs on port 5173.
CLIENT_URL=http://localhost:5173
# Only needed if the website and the API are hosted on different domains (comma separated).
CORS_ORIGINS=

# --- First admin account ---
# On start-up, if no user with this email exists, an admin account is created with these details.
ADMIN_NAME=RaktSetu Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_PHONE=

# --- Demo data ---
# DEMO_MODE shows the "demo accounts" buttons on the login page (defaults to true in development).
DEMO_MODE=
# Local development only; keep false on Vercel (automatic seeding is rejected there).
SEED_DEMO_DATA=false

# --- Email (optional, for password-reset emails) ---
# Without SMTP, email is not delivered. Reset links are logged only outside production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=RaktSetu <no-reply@raktsetu.in>

# Vercel serves client/dist itself; the local Node server defaults to true.
# SERVE_CLIENT=false
